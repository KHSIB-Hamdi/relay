# Normalize line endings: LF in the repository, native in the working tree.
# Without this, committing from Windows produces CRLF warnings on every file.
* text=auto

*.js   text eol=lf
*.jsx  text eol=lf
*.json text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.md   text eol=lf
*.yml  text eol=lf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.svg  text eol=lf
*.ico  binary
*.pdf  binary
*.docx binary
