# Copy to backend/.env and fill in real values. Never commit backend/.env.

# NOTE: currently ignored. server.js reads process.env.PORT before dotenv.config()
# runs, so the server always binds 8000. See "Known issues" in the root README.
PORT=8000

# MongoDB connection string (local instance or Atlas SRV URI)
MONGO_URI=mongodb://localhost:27017/csrm

# JWT signing secrets — use two different long random strings
ACCESS_TOKEN_SECRET=replace-with-a-long-random-string
REFRESH_TOKEN_SECRET=replace-with-a-different-long-random-string

# SMTP credentials used by config/mailer.js (nodemailer, service: gmail).
# For Gmail this must be an App Password, not the account password.
SMTP_USER=your-address@example.com
SMTP_PASS=your-smtp-app-password
SMTP_FROM=your-address@example.com
